{
	"schemaVersion": 1,
	"id": "picktweak",
	"version": "${version}",
	"name": "Pick Tweak",
	"description": "masa 系列的拾取增强：远距离拾取方块 / 实体 / NBT / 状态属性，ID 复制，智能选工具与武器。服务端提供权威拾取服务（不依赖 MaLiLib）；客户端安装 MaLiLib 可使用配置面板与自定义热键，未安装时使用默认配置与原版按键。",
	"authors": [
		"HeCUan"
	],
	"license": "MIT",
	"icon": "assets/picktweak/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fi.dy.masa.picktweak.PickTweak"
		],
		"client": [
			"fi.dy.masa.picktweak.PickBlockProClient"
		],
		"modmenu": [
			"fi.dy.masa.picktweak.compat.ModMenuImpl"
		]
	},
	"mixins": [
		"picktweak.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"malilib": ">=0.30.2",
		"modmenu": "*",
		"litematica": "*",
		"axiom": "*"
	}
}